{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikmarch/open-data-duck/schema/source.schema.json",
  "title": "Open Data Duck source registry",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "source_type",
        "authority",
        "license_url",
        "attribution",
        "tables"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "connector-blocked",
            "verified",
            "deprecated"
          ]
        },
        "source_type": {
          "enum": [
            "overture",
            "stac",
            "arcgis",
            "parquet",
            "ckan",
            "dcat",
            "socrata",
            "iceberg",
            "ducklake",
            "other"
          ]
        },
        "authority": {
          "type": "string"
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "type": "string"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "discovery": {
          "$ref": "#/$defs/discovery"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table"
          },
          "minItems": 1
        },
        "release": {
          "$ref": "#/$defs/release"
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "duckdb_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": [
        "namespace",
        "discover_sql"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^odd\\.[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "discover_sql": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "ref": {
          "type": "string",
          "pattern": "^odd\\.[a-z0-9_]+\\.[a-z0-9x_]+\\.[a-z0-9_]+$"
        },
        "description": {
          "type": "string"
        },
        "columns_hint": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ask_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_org": {
          "$ref": "#/$defs/table_schema_org"
        },
        "ai_capabilities": {
          "$ref": "#/$defs/ai_capabilities"
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "table_schema_org": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        },
        "spatialCoverage": {
          "type": "string"
        },
        "temporalCoverage": {
          "type": "string"
        },
        "variableMeasured": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "@type": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "unitText": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "measurementTechnique": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distribution": {
          "type": "object",
          "properties": {
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "contentUrl": {
              "type": "string"
            },
            "encodingFormat": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ai_capabilities": {
      "type": "object",
      "required": [
        "grain",
        "safe_operations",
        "example_questions"
      ],
      "properties": {
        "grain": {
          "type": "string"
        },
        "geography_level": {
          "type": "string"
        },
        "join_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "references": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "time": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "grain": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ai_field"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ai_field"
          }
        },
        "safe_operations": {
          "type": "array",
          "items": {
            "enum": [
              "rank",
              "compare",
              "correlate",
              "map",
              "trend",
              "summarize",
              "join"
            ]
          },
          "minItems": 1
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "missing_for_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "missing_source_families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_metrics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ai_field": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "id",
        "direct_sql",
        "odd_sql"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^odd\\.[a-z0-9_]+\\.[a-z0-9x_]+\\.[a-z0-9_]+$"
        },
        "description": {
          "type": "string"
        },
        "release": {
          "type": "string",
          "pattern": "^[a-z0-9x_]+$"
        },
        "source_release": {
          "type": "string"
        },
        "direct_sql": {
          "type": "string"
        },
        "odd_sql": {
          "type": "string"
        },
        "compare": {
          "enum": [
            "exact",
            "set",
            "count"
          ]
        },
        "order_by": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "method": {
              "type": "string"
            },
            "resolve_sql": {
              "type": "string"
            }
          }
        },
        "pinned": {
          "type": "object",
          "required": [
            "duckdb_setting",
            "example"
          ],
          "properties": {
            "duckdb_setting": {
              "type": "string"
            },
            "example": {
              "type": "string"
            },
            "s3_base_setting": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
