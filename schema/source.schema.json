{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikmarch/open-data-duck/schema/source.schema.json",
  "title": "Open Data Duck source registry",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "description", "status", "source_type", "authority", "homepage", "license_url", "attribution", "duckdb"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "enum": ["candidate", "connector-blocked", "verified", "deprecated"] },
        "source_type": { "enum": ["overture", "stac", "arcgis", "parquet", "ckan", "dcat", "socrata", "iceberg", "ducklake", "other"] },
        "authority": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "license_url": { "type": "string", "format": "uri" },
        "attribution": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "topics": { "type": "array", "items": { "type": "string" } },
        "coverage": {
          "type": "object",
          "properties": {
            "spatial": { "type": "string" },
            "temporal": { "type": "string" },
            "grain": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "cadence": { "type": "string" },
        "ai": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "use_cases": { "type": "array", "items": { "type": "string" } },
            "caveats": { "type": "array", "items": { "type": "string" } },
            "prompt_hints": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "duckdb": {
          "type": "object",
          "required": ["extensions", "example_query", "validation_query"],
          "properties": {
            "extensions": { "type": "array", "items": { "type": "string" } },
            "install": { "type": "string" },
            "example_query": { "type": "string" },
            "validation_query": { "type": "string" },
            "examples": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "tables": {
              "type": "object",
              "required": ["namespace", "discover_sql"],
              "properties": {
                "namespace": { "type": "string", "pattern": "^odd\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
                "discover_sql": { "type": "string" }
              }
            }
          }
        },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation" }
        },
        "release": { "$ref": "#/$defs/release" },
        "freshness": {
          "type": "object",
          "properties": {
            "method": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["id", "direct_sql", "odd_sql"],
      "properties": {
        "id": { "type": "string", "pattern": "^odd\\.[a-z0-9_]+\\.[a-z0-9x_]+\\.[a-z0-9_]+$" },
        "description": { "type": "string" },
        "release": { "type": "string", "pattern": "^[a-z0-9x_]+$" },
        "source_release": { "type": "string" },
        "direct_sql": { "type": "string" },
        "odd_sql": { "type": "string" },
        "compare": { "enum": ["exact", "set", "count"] },
        "order_by": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "limit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "method": { "type": "string" },
            "resolve_sql": { "type": "string" }
          }
        },
        "pinned": {
          "type": "object",
          "required": ["duckdb_setting", "example"],
          "properties": {
            "duckdb_setting": { "type": "string" },
            "example": { "type": "string" },
            "s3_base_setting": { "type": "string" }
          }
        }
      }
    }
  }
}
