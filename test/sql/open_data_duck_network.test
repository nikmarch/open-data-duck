# name: test/sql/open_data_duck_network.test
# description: table discovery and data facades against the public endpoints
# group: [sql]

require open_data_duck

require httpfs

require json

require parquet

require spatial

require-env ODD_DUCKDB_NETWORK_TESTS

# Discovery runs release.latest.resolve_sql + duckdb.tables.discover_sql once per
# source@release and caches the rows for the rest of the process.
query I
SELECT open_data_release('overture.maps.release') SIMILAR TO '[0-9]{4}-[0-9]{2}-[0-9]{2}\.[0-9]+';
----
true

query II
SELECT table_reference, reader
FROM odd.tables
WHERE table_reference IN ('odd.overturemaps.latest.building', 'odd.overturemaps.latest.place', 'odd.census.latest.county_20m', 'odd.census_dhc_nmf.x2020.dhch_block_constraint', 'odd.census_pl94_nmf.x2020.person_pl_state_constraint', 'odd.cdc.latest.chronic_disease_indicators', 'odd.cdc.latest.leading_causes_of_death', 'odd.chicago.latest.building_permits', 'odd.cms.latest.medicare_monthly_enrollment', 'odd.fema.latest.disaster_declarations', 'odd.fema.latest.public_assistance_funded_projects', 'odd.meta_hrsl.latest.population_points', 'odd.nasa_exoplanet_archive.latest.planetary_systems_composite', 'odd.noaa.latest.ghcn_daily', 'odd.noaa_coops.latest.hourly_heights', 'odd.noaa_swpc.latest.boulder_k_index_1m', 'odd.nps.latest.monthly_visitor_stats', 'odd.nps.latest.state_monthly_visitor_stats', 'odd.nyc_tlc.latest.yellow_tripdata', 'odd.openalex.latest.authors', 'odd.sec_edgar.latest.companyfacts', 'odd.usgs_gnis.latest.domestic_names', 'odd.wri.latest.global_power_plants')
ORDER BY table_reference;
----
odd.cdc.latest.chronic_disease_indicators	read_csv_auto
odd.cdc.latest.leading_causes_of_death	read_csv_auto
odd.census.latest.county_20m	st_read
odd.census_dhc_nmf.x2020.dhch_block_constraint	read_parquet
odd.census_pl94_nmf.x2020.person_pl_state_constraint	read_parquet
odd.chicago.latest.building_permits	read_csv_auto
odd.cms.latest.medicare_monthly_enrollment	read_csv_auto
odd.fema.latest.disaster_declarations	read_parquet
odd.fema.latest.public_assistance_funded_projects	read_parquet
odd.meta_hrsl.latest.population_points	read_csv_auto
odd.nasa_exoplanet_archive.latest.planetary_systems_composite	read_csv_auto
odd.noaa.latest.ghcn_daily	read_csv
odd.noaa_coops.latest.hourly_heights	read_csv_auto
odd.noaa_swpc.latest.boulder_k_index_1m	read_json_auto
odd.nps.latest.monthly_visitor_stats	read_csv_auto
odd.nps.latest.state_monthly_visitor_stats	read_csv_auto
odd.nyc_tlc.latest.yellow_tripdata	read_parquet
odd.openalex.latest.authors	read_json_auto
odd.overturemaps.latest.building	read_parquet
odd.overturemaps.latest.place	read_parquet
odd.sec_edgar.latest.companyfacts	read_json_auto
odd.usgs_gnis.latest.domestic_names	st_read
odd.wri.latest.global_power_plants	read_csv

query I
SELECT path LIKE 's3://overturemaps-us-west-2/release/' || release || '/theme=buildings/type=building/*'
FROM open_data_tables()
WHERE table_reference = 'odd.overturemaps.latest.building';
----
true

query I
SELECT count(*) >= 15 FROM odd.tables WHERE source_id = 'overture.maps.release';
----
true

# Pinning changes which release is discovered.
statement ok
SET VARIABLE overture_release = '2026-10-21.0';

query I
SELECT path FROM odd.tables WHERE table_reference = 'odd.overturemaps.latest.place';
----
s3://overturemaps-us-west-2/release/2026-10-21.0/theme=places/type=place/*

statement ok
RESET VARIABLE overture_release;

# The data facade binds reader(path) through the replacement scan.
statement ok
SET s3_region = 'us-west-2';

query I
SELECT count(*) > 0
FROM odd.overturemaps.latest.place
WHERE bbox.xmin <= -149 AND bbox.xmax >= -150 AND bbox.ymin <= 61 AND bbox.ymax >= 60;
----
true

query I
SELECT count(*) > 0
FROM odd.overturemaps.latest.address
WHERE bbox.xmin <= -149.37 AND bbox.xmax >= -149.39 AND bbox.ymin <= 61.61 AND bbox.ymax >= 61.60;
----
true

query I
SELECT count(*) > 0
FROM odd.overturemaps.latest.segment
WHERE bbox.xmin <= -149.37 AND bbox.xmax >= -149.39 AND bbox.ymin <= 61.61 AND bbox.ymax >= 61.60;
----
true

query I
SELECT count(*) = 5
FROM odd.usgs_gnis.latest.domestic_names
WHERE feature_id IN (1388627, 1388628, 1388629, 1388631, 1388632);
----
true

query I
SELECT count(*) > 0 FROM odd.noaa.latest.ghcn_daily LIMIT 1;
----
true

query I
SELECT count(*) = 48 FROM odd.noaa_coops.latest.hourly_heights;
----
true

query I
SELECT count(*) = 1
FROM odd.nasa_exoplanet_archive.latest.planetary_systems_composite
WHERE pl_name = 'Kepler-22 b'
  AND hostname = 'Kepler-22'
  AND discoverymethod = 'Transit'
  AND disc_year = 2011;
----
true

query IIIII
SELECT count(*) AS row_count,
       min(Year) AS min_year,
       max(Year) AS max_year,
       count(DISTINCT UnitCode) AS units,
       count(DISTINCT Statistic) AS statistics
FROM odd.nps.latest.state_monthly_visitor_stats
WHERE StateID = 'AK'
  AND Year BETWEEN 2024 AND 2025;
----
5760	2024	2025	16	15

query IIIII
SELECT count(*) AS row_count,
       min(yearstart) AS min_year,
       max(yearstart) AS max_year,
       count(DISTINCT topic) AS topics,
       count(DISTINCT question) AS questions
FROM odd.cdc.latest.chronic_disease_indicators;
----
983	2023	2023	14	48

query IIII
SELECT count(*) AS row_count,
       min(year) AS first_year,
       max(year) AS last_year,
       CAST(sum(CASE WHEN year = 2017 AND cause_name <> 'All causes' THEN deaths ELSE 0 END) AS BIGINT) AS ranked_deaths_2017
FROM odd.cdc.latest.leading_causes_of_death
WHERE state = 'Alaska';
----
209	1999	2017	3118

query ITTII
SELECT count(*) AS row_count,
       CAST(min(issue_date) AS VARCHAR) AS min_issue_date,
       CAST(max(issue_date) AS VARCHAR) AS max_issue_date,
       count(DISTINCT permit_type) AS permit_types,
       CAST(round(sum(reported_cost), 2) AS BIGINT) AS reported_cost_sum
FROM odd.chicago.latest.building_permits;
----
287	2024-01-02	2024-02-01	5	54476382

query IIII
SELECT count(*) AS row_count,
       min("YEAR") AS min_year,
       max("YEAR") AS max_year,
       CAST(sum(TRY_CAST(TOT_BENES AS BIGINT)) AS BIGINT) AS total_benes_sum
FROM odd.cms.latest.medicare_monthly_enrollment
WHERE BENE_GEO_LVL = 'National'
  AND "YEAR" = 2026;
----
7	2026	2026	493599098

statement ok
SET VARIABLE fema_disaster_declarations_release = 'v2';

query I
SELECT count(*) > 0
FROM odd.fema.latest.disaster_declarations
WHERE state = 'AK';
----
true

statement ok
SET VARIABLE fema_public_assistance_funded_projects_release = 'v2';

query I
SELECT count(*) > 0
FROM odd.fema.latest.public_assistance_funded_projects
WHERE stateAbbreviation = 'AK';
----
true

statement ok
SET VARIABLE wri_global_power_plants_release = 'v1x3x0';

query I
SELECT count(*) > 0
FROM odd.wri.latest.global_power_plants
WHERE country = 'UZB';
----
true

statement error
SELECT * FROM odd.overturemaps.latest.not_a_collection;
----
open_data_duck: no table 'not_a_collection' under odd.overturemaps.latest
