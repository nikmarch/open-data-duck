# name: test/sql/open_data_duck.test
# description: smoke test the open_data_duck extension scaffold
# group: [sql]

# Before the extension is loaded, this should fail.
statement error
SELECT open_data_duck_ping();
----
Catalog Error: Scalar Function with name open_data_duck_ping does not exist!

require open_data_duck

query I
SELECT open_data_duck_ping();
----
open_data_duck: pong

query I
SELECT length(open_data_duck_version()) > 0;
----
true

# The embedded registry is generated from registry/sources.yml at development time.
query I
SELECT open_data_duck_registry_source_count() > 0;
----
true

require json

query I
SELECT json_valid(open_data_duck_registry_json());
----
true

query I
SELECT open_data_duck_registry_json()->>'$.schema_version';
----
1

query I
SELECT json_array_length(open_data_duck_registry_json(), '$.sources') = open_data_duck_registry_source_count();
----
true
