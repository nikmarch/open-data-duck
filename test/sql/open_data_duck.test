# name: test/sql/open_data_duck.test
# description: smoke test the open_data_duck extension scaffold and core registry functions
# group: [sql]

# Before the extension is loaded, this should fail.
statement error
SELECT open_data_duck_ping();
----
Catalog Error: Scalar Function with name open_data_duck_ping does not exist!

require open_data_duck

query I
SELECT open_data_duck_ping();
----
open_data_duck: pong

query I
SELECT length(open_data_duck_version()) > 0;
----
true

# The embedded registry is generated from registry/sources.yml at development time.
query I
SELECT open_data_duck_registry_source_count() > 0;
----
true

require json

query I
SELECT json_valid(open_data_duck_registry_json());
----
true

query I
SELECT open_data_duck_registry_json()->>'$.schema_version';
----
1

query I
SELECT json_array_length(open_data_duck_registry_json(), '$.sources') = open_data_duck_registry_source_count();
----
true

# --- Issue #32: core registry functions -------------------------------------
# These never touch the network; they only read the embedded registry.

# open_data_sources() exposes stable, SQL-filterable columns.
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM open_data_sources());
----
id	VARCHAR
name	VARCHAR
source_type	VARCHAR
status	VARCHAR
description	VARCHAR
authority	VARCHAR
homepage	VARCHAR
license_url	VARCHAR
attribution	VARCHAR
tags	VARCHAR[]
extensions	VARCHAR[]
install	VARCHAR
example_query	VARCHAR
validation_query	VARCHAR
namespace	VARCHAR

query I
SELECT count(*) = open_data_duck_registry_source_count() FROM open_data_sources();
----
true

query I
SELECT count(*) FROM open_data_sources() WHERE id = 'overture.maps.release';
----
1

# Ids are unique and never empty.
query I
SELECT count(DISTINCT id) = count(*) AND bool_and(length(id) > 0) FROM open_data_sources();
----
true

# Plain SQL filtering replaces the CLI's --type / --status flags.
query I
SELECT bool_and(source_type = 'overture') FROM open_data_sources() WHERE source_type = 'overture';
----
true

# open_data_search() matches every whitespace-separated term, case-insensitively,
# the same way `odd search` does.
query I
SELECT id FROM open_data_search('overture');
----
overture.maps.release

query I
SELECT namespace FROM open_data_search('building') WHERE id = 'overture.maps.release';
----
odd.overturemaps.latest

# Sources that expose tables do so under a three-part odd.<provider>.<version> namespace.
query I
SELECT bool_and(namespace SIMILAR TO 'odd\.[a-z0-9_]+\.[a-z0-9_]+') FROM open_data_sources() WHERE namespace <> '';
----
true

query I
SELECT list(DISTINCT namespace ORDER BY namespace) FROM open_data_sources() WHERE namespace <> '';
----
[odd.census.latest, odd.noaa.latest, odd.overturemaps.latest]

query I
SELECT count(*) > 0 FROM open_data_search('OVERTURE');
----
true

query I
SELECT count(*) FROM open_data_search('this-term-matches-nothing');
----
0

# An empty query matches everything, like `odd search ""`.
query I
SELECT count(*) = open_data_duck_registry_source_count() FROM open_data_search('');
----
true

# Multi-term search narrows results (AND semantics).
query I
SELECT count(*) <= (SELECT count(*) FROM open_data_search('stac')) FROM open_data_search('stac sentinel');
----
true

statement error
SELECT * FROM open_data_search(NULL);
----
Binder Error: open_data_search(query) requires a non-NULL search string

# open_data_sql() returns install statements, a blank line, then the example query.
query I
SELECT open_data_sql('overture.maps.release') LIKE 'INSTALL httpfs;' || chr(10) || chr(10) || 'LOAD httpfs;%';
----
true

query I
SELECT open_data_sql('overture.maps.release') LIKE '%LIMIT 10;' || chr(10);
----
true

query I
SELECT open_data_validation_sql('overture.maps.release') LIKE '%small_bbox_query_ok%';
----
true

# Table discovery (odd.tables / open_data_tables()) and the data facades need the
# network; they live in test/sql/open_data_duck_network.test.

# open_data_release(source_id) resolves the release a `latest` table will read.
# The pinned variable from release.pinned.duckdb_setting wins over the network lookup,
# so this stays offline.
statement ok
SET VARIABLE overture_release = '2026-10-21.0';

query I
SELECT open_data_release('overture.maps.release');
----
2026-10-21.0

statement ok
SET VARIABLE overture_release = '2026-09-23.1';

query I
SELECT open_data_release('overture.maps.release');
----
2026-09-23.1

statement ok
RESET VARIABLE overture_release;

query I
SELECT open_data_release(NULL) IS NULL;
----
true

statement error
SELECT open_data_release('nope.missing');
----
open_data_duck: unknown source id 'nope.missing'

# Every source with {release} tables has its own pin variable.
statement ok
SET VARIABLE census_cartographic_year = '2024';

query I
SELECT open_data_release('census.cartographic.county-boundaries');
----
2024

statement ok
RESET VARIABLE census_cartographic_year;

# Sources without a latest-release recipe cannot be resolved.
statement error
SELECT open_data_release('stac.earth-search.aws');
----
open_data_duck: source 'stac.earth-search.aws' has no release.latest.resolve_sql

# Issue #79: attached ODD namespace exposes discovery as tables.
query I
SELECT id FROM odd.index WHERE list_contains(tags, 'buildings') AND id = 'overture.maps.release';
----
overture.maps.release

# Issue #83: attaching TYPE open_data_duck creates a real virtual catalog with
# catalog views instead of an empty DuckDB file.
statement ok
ATTACH 'odd' AS odd_catalog (TYPE open_data_duck);

query I
SELECT id FROM odd_catalog.index WHERE list_contains(tags, 'buildings') AND id = 'overture.maps.release';
----
overture.maps.release

query I
SHOW TABLES FROM odd_catalog;
----
index
tables

# An unknown name under a known namespace must not be swallowed by the replacement scan
# before the catalog error; a name outside every namespace is left to DuckDB.
statement error
SELECT * FROM odd.nothing.here.at_all;
----
does not exist

# The recipe text matches what the embedded registry carries for that source.
query I
SELECT open_data_sql(id) = install || chr(10) || chr(10) || example_query || chr(10)
FROM open_data_sources() WHERE id = 'overture.maps.release';
----
true

# NULL in, NULL out.
query I
SELECT open_data_sql(NULL) IS NULL;
----
true

# Missing source ids return clear errors.
statement error
SELECT open_data_sql('nope.missing');
----
open_data_duck: unknown source id 'nope.missing'

statement error
SELECT open_data_validation_sql('nope.missing');
----
open_data_duck: unknown source id 'nope.missing'
