flowchart TD
  CLI["odd/cli.py\nargparse commands"] --> RegistryFacade["odd/registry.py\ncompatibility facade"]
  CLI --> ExtensionRegistry["odd/extension_registry.py\ngenerate C++ registry header"]
  CLI --> SchemaManifest["odd/schema_manifest.py\nschema inspect/check/refresh"]

  RegistryFacade --> RegistryModel["odd/registry_model.py\nSource + load/search"]
  RegistryFacade --> RegistryRenderers["odd/registry_renderers.py\nSQL/Markdown/JSON/site renderers"]
  RegistryFacade --> RegistryValidation["odd/registry_validation.py\nschema + hygiene validation"]

  MCP["odd/mcp_server.py\noptional MCP tools"] --> RegistryFacade
  MCP --> SchemaManifest

  SchemaManifest --> RegistryFacade
  SchemaManifest --> SQLHelpers["sql/open_data_duck.sql\nDuckDB schema helper SQL"]

  ExtensionRegistry --> RegistryFacade
  ExtensionRegistry --> GeneratedHeader["src/include/open_data_duck_registry.generated.hpp\nREGISTRY_JSON"]

  SourcesYaml["registry/sources.yml\nsource of truth"] --> RegistryModel
  SourceSchema["schema/source.schema.json"] --> RegistryValidation
  SchemaManifestFile["schema/source-manifest.json"] --> SchemaManifest

  BuildPages["scripts/build_pages_site.py"] --> RegistryFacade
  BuildPages --> SiteStatic["site/\nstatic assets"]
  BuildPages --> BrandAssets["docs/assets/brand/\nbrand assets"]
  RegistryRenderers --> DocsIndex["docs/index.md\ngenerated Markdown"]
  RegistryRenderers --> SiteIndex["site/index.html / _site/index.html\ngenerated HTML"]

  ExtensionCpp["src/open_data_duck_extension.cpp\nnative DuckDB extension"] --> GeneratedHeader
  ExtensionCpp --> DuckDB["DuckDB extension APIs"]

  SQLTests["test/sql/open_data_duck*.test\nsqllogictest"] --> ExtensionCpp
  PyTests["tests/*.py\nPython tests"] --> CLI
  PyTests --> RegistryFacade
  PyTests --> ExtensionRegistry
  PyTests --> SchemaManifest

  ArcGIS["odd/arcgis.py"] -. source-family helpers .-> RegistryModel
  CKAN["odd/ckan.py"] -. source-family helpers .-> RegistryModel
  Socrata["odd/socrata.py"] -. source-family helpers .-> RegistryModel

  classDef source fill:#f5f5ff,stroke:#555;
  classDef generated fill:#fff3cc,stroke:#996b00;
  classDef native fill:#eef7ee,stroke:#27632a;
  class SourcesYaml,SourceSchema,SchemaManifestFile source;
  class GeneratedHeader,DocsIndex,SiteIndex generated;
  class ExtensionCpp,DuckDB native;
